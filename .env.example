# ──────────────────────────────────────────────
# Mock Zoho CRM API — Configuration
# All vars are prefixed with MOCKZOHO_
# ──────────────────────────────────────────────

# Server
MOCKZOHO_HOST=0.0.0.0
MOCKZOHO_PORT=8090

# Database (SQLite by default)
MOCKZOHO_DATABASE_URL=sqlite:///./mockzoho.db

# Seed behaviour
MOCKZOHO_SEED_ON_STARTUP=true
MOCKZOHO_RESET_DB_ON_STARTUP=false

# API domain returned in OAuth token responses
MOCKZOHO_API_DOMAIN=http://localhost:8090

# Timezone offset for timestamps (ISO 8601)
MOCKZOHO_TIMEZONE_OFFSET=+08:00

# OAuth token TTL (seconds)
MOCKZOHO_TOKEN_TTL_SECONDS=3600

# OAuth credential validation (leave blank to accept any credentials)
# MOCKZOHO_EXPECTED_CLIENT_ID=1000.XXXXXXXXXXXX
# MOCKZOHO_EXPECTED_CLIENT_SECRET=your_client_secret
# MOCKZOHO_EXPECTED_REFRESH_TOKEN=1000.XXXXXXXXXXXX.refresh

# Rate limiting
MOCKZOHO_RATE_LIMIT_CREDITS=5000
MOCKZOHO_RATE_LIMIT_WINDOW_SECONDS=60

# Request log size (number of entries kept in memory)
MOCKZOHO_REQUEST_LOG_SIZE=200

# Write limits
MOCKZOHO_MAX_RECORDS_PER_WRITE=100
MOCKZOHO_MAX_PER_PAGE=200
MOCKZOHO_DEFAULT_PER_PAGE=200
